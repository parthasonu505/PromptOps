# PromptOps Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Required: Database
# ===========================================
# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# Required: Security
# ===========================================
# Session secret for Express sessions (generate a random string)
SESSION_SECRET=your-secure-session-secret-min-32-chars

# JWT secret for authentication tokens (generate a random string)
JWT_SECRET=your-secure-jwt-secret-min-32-chars

# Encryption key for API keys storage (exactly 32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# Optional: LLM Providers
# ===========================================
# Google Gemini API Key (for Gemini models)
GOOGLE_API_KEY=

# GitHub Token (for GitHub Models - requires models:read scope)
GITHUB_TOKEN=

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=

# ===========================================
# Optional: GitHub Integration
# ===========================================
# GitHub repository for prompt version control
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ===========================================
# Application Settings
# ===========================================
# Server port (default: 5000)
PORT=5000

# Node environment (development/production)
NODE_ENV=production
